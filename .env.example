# 로컬 개발용 예시예요. 복사해서 .env 로 만들어 쓰세요 (.env 는 커밋하지 않아요).

# 글과 파일을 저장할 레포지토리와 브랜치
VITE_GH_REPO=Ausdauer1/hiair
VITE_DATA_BRANCH=data

# 이 레포지토리 한 곳에만 쓰기 권한(Contents: Read and write)을 준 fine-grained 토큰
VITE_GH_TOKEN=

# 업체 목록과 비밀번호 (첫 번째 업체가 기본 선택이에요)
VITE_COMPANIES=[{"name":"하이에어코리아","password":"0000"},{"name":"협력업체 A","password":"1111"},{"name":"협력업체 B","password":"2222"},{"name":"협력업체 C","password":"3333"}]
